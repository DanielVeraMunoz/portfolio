---
import info from '../data/info.json';

const { skills } = info;
const skillsMap = skills as Record<string, { name: string; icon: string }[]>;

const skillCategories = [
  { key: 'backend', title: 'Backend' },
  { key: 'frontend', title: 'Frontend' },
  { key: 'databases', title: 'Bases de Datos' },
  { key: 'testing', title: 'Testing' },
  { key: 'tools', title: 'Herramientas' },
  { key: 'methodologies', title: 'Metodologías' },
];

const categoryIcons: Record<string, string> = {
  backend: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`,
  frontend: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  databases: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>`,
  testing: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>`,
  tools: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>`,
  methodologies: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6m-6 4h6"/></svg>`,
};
---

<section id="skills" class="py-20 bg-dark-light/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        Mis skills
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Tecnologías y herramientas con las que trabajo
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillCategories.map((category, categoryIndex) => (
        skillsMap[category.key] && skillsMap[category.key].length > 0 && (
          <div
            class="reveal glass rounded-2xl p-6 card-hover"
            style={`animation-delay: ${categoryIndex * 0.1}s`}
          >
            <div class="flex items-center gap-3 mb-5">
              <div class="p-2 bg-primary/20 rounded-lg text-primary">
                <Fragment set:html={categoryIcons[category.key] || ''} />
              </div>
              <h3 class="text-lg font-bold text-light">{category.title}</h3>
            </div>

            <div class="flex flex-wrap gap-3">
              {skillsMap[category.key]?.map((skill) => (
                <div
                  class="group flex items-center gap-2 px-3 py-2 bg-dark rounded-lg hover:bg-primary/20 transition-all cursor-default"
                  title={skill.name}
                >
                  <span class="text-gray-300 text-sm font-medium group-hover:text-primary transition-colors">
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )
      ))}
    </div>


  </div>
</section>
